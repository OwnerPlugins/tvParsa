msgid "Back"
msgstr "ត្រឡប់មកវិញ"

msgid "Congrats! You already have the latest version..."
msgstr "អបអរសាទរ! អ្នកមានកំណែចុងក្រោយបង្អស់..."

msgid "Convert"
msgstr "បម្លែង"

msgid "Do you want to install update ( %s ) now?"
msgstr "តើអ្នកចង់ដំឡើងអាប់ដេត (%s) ឥឡូវនេះទេ?"

msgid "Exit"
msgstr "ចេញ"

msgid "Loading data... Please wait"
msgstr "កំពុងផ្ទុកទិន្នន័យ... សូមរង់ចាំ"

msgid "PARSA ALL TV"
msgstr "វាបង្ហាញនៅលើទូរទស្សន៍ទាំងអស់។"

msgid "PARSA SPORT"
msgstr ""

msgid "PARSA TV CATEGORY"
msgstr "ប្រភេទទូរទស្សន៍ PARSA"

msgid "Play"
msgstr "លេង"

msgid "Please select ..."
msgstr "សូមជ្រើសរើស..."

msgid "Select"
msgstr "ជ្រើសរើស"

msgid "Update"
msgstr "ធ្វើបច្ចុប្បន្នភាព"

msgid "Update Aborted!"
msgstr "ការអាប់ដេតត្រូវបានលុបចោល!"

msgid "bouquets reloaded.."
msgstr "ភួងត្រូវបានផ្ទុកឡើងវិញ .."
