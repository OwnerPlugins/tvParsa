msgid "PARSA TV CATEGORY"
msgstr "ಪಾರ್ಸಾ ಟಿವಿ ವರ್ಗ"

msgid "Play"
msgstr "ಪ್ಲೇ ಮಾಡಿ"

msgid "Please select ..."
msgstr "ದಯವಿಟ್ಟು ಆಯ್ಕೆಮಾಡಿ..."

msgid "Select"
msgstr "ಆಯ್ಕೆ ಮಾಡಿ"

msgid "Update"
msgstr "ನವೀಕರಿಸಿ"

msgid "Update Aborted!"
msgstr "ನವೀಕರಣವನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಲಾಗಿದೆ!"

msgid "bouquets reloaded.."
msgstr "ಹೂಗುಚ್ಛಗಳನ್ನು ಮರುಲೋಡ್ ಮಾಡಲಾಗಿದೆ.."
