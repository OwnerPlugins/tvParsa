msgid "Select"
msgstr "ਚੁਣੋ"

msgid "Update"
msgstr "ਅੱਪਡੇਟ ਕਰੋ"

msgid "Update Aborted!"
msgstr "ਅੱਪਡੇਟ ਅਧੂਰਾ ਛੱਡਿਆ ਗਿਆ!"

msgid "bouquets reloaded.."
msgstr "ਗੁਲਦਸਤੇ ਮੁੜ ਲੋਡ ਕੀਤੇ ਗਏ.."
