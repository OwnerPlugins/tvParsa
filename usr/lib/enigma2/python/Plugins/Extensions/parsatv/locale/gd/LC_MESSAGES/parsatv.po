msgstr "Tagh"

msgid "Update"
msgstr "Ùraich"

msgid "Update Aborted!"
msgstr "Ùrachadh air a sguireadh!"

msgid "bouquets reloaded.."
msgstr "Bouquet na flùraichean a luchdadh a-nuas. ."
